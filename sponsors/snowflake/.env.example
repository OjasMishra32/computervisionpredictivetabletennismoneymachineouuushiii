# COURTSIDE Warehouse: copy these lines into the repo-root .env (gitignored) and fill them in. Never commit .env.
# Account identifier: Snowsight > your name (bottom left) > Account > "Copy account identifier", e.g. ORGNAME-ACCTNAME
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
# Sign in with a key pair (scripts can't answer an MFA prompt). Make one, outside the repo:
#   mkdir -p ~/.snowflake && openssl genrsa 2048 | openssl pkcs8 -topk8 -nocrypt -out ~/.snowflake/courtside_rsa_key.p8
#   openssl rsa -in ~/.snowflake/courtside_rsa_key.p8 -pubout   # paste the body into ALTER USER ... SET RSA_PUBLIC_KEY
# (README.md, "Sign-in", has the one statement to run in a Snowsight worksheet.)
SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/courtside_rsa_key.p8
# Alternatives (first one set wins: token, key pair, authenticator, password):
# SNOWFLAKE_TOKEN=            # programmatic access token (may need a network policy on your user)
# SNOWFLAKE_AUTHENTICATOR=    # externalbrowser works only for accounts with SAML single sign-on
# SNOWFLAKE_PASSWORD=         # usually blocked for human users with MFA
# Warehouse: older trials have COMPUTE_WH, newer ones SNOWFLAKE_LEARNING_WH (run SHOW WAREHOUSES)
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=COURTSIDE
SNOWFLAKE_SCHEMA=WAREHOUSE
